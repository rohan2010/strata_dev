# Copy to `.env` (git-ignored) and fill in only what you need.
# An exported shell variable always wins over this file.
#
# You do NOT need every provider. A run only needs credentials for the providers
# its routes actually reach — see `conductor doctor` for exactly which those are,
# and `conductor models` for which model serves which role.

# --- Model providers -------------------------------------------------------

# Anthropic. Alone, this is enough for a first run: planner, implementer, and
# the reviewer's fallback all resolve to Opus.
ANTHROPIC_API_KEY=

# OpenAI. Only reached today as the implementer's fallback.
OPENAI_API_KEY=

# Google Gemini. Either name works; GOOGLE_API_KEY is checked first.
# Currently the reviewer's PREFERRED model, so without this the reviewer fails
# its first candidate every run and falls back to Opus — which works, but costs
# a wasted call and loses the cross-vendor independence that ordering is for.
GOOGLE_API_KEY=

# Ollama needs no key — just a running daemon. Override the default
# http://localhost:11434 per model in models.yaml via `params: {base_url: ...}`.

# --- Connectors ------------------------------------------------------------

# Optional. The GitHub connector falls back to the `gh` CLI keyring when unset,
# which is already working on this machine.
GITHUB_TOKEN=
